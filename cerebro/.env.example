# CEREBRO configuration. Copy to cerebro/.env (or the repo-root .env) on the machine that
# runs the backend. Real environment variables (e.g. systemd Environment=) win over this file.
# .env is gitignored: never commit real keys.

# --- LLM (Groq by default; the client is OpenAI-compatible, so Ollama etc. plug in here) ---
GROQ_API_KEY=
LLM_PROVIDER=groq            # groq | ollama | openai_compat | fake
LLM_MODEL=openai/gpt-oss-120b   # openai/gpt-oss-20b is the faster/cheaper alternative
LLM_FALLBACK_MODEL=openai/gpt-oss-20b   # used on a 429 rate limit (own quota); empty = off
#LLM_BASE_URL=               # empty = provider default (e.g. http://localhost:11434/v1 for ollama)
#LLM_API_KEY=                # for non-Groq providers; falls back to GROQ_API_KEY
LLM_TIMEOUT_S=20
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=400
LLM_STRUCTURED=json_schema   # json_schema | json_object | none
LLM_REASONING_EFFORT=low     # gpt-oss models only: low | medium | high

# --- STT (faster-whisper, local) ---
STT_BACKEND=faster_whisper   # faster_whisper | fake
STT_MODEL=small              # tiny | base | small | medium | large-v3 ... (slower CPU => smaller)
STT_LANGUAGE=es              # empty = auto-detect
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=0            # 0 = library default

# --- TTS (Piper, local) ---
TTS_BACKEND=piper            # piper | fake
TTS_VOICE=es_ES-davefx-medium
TTS_LENGTH_SCALE=1.0         # >1 = slower, deeper feel
TTS_PEAK=0.35                # reply loudness (fraction of full scale) at the ESP32 speaker
TTS_FX=monster               # monster | none  (deep, gravelly voice on top of Piper)
TTS_PITCH_SEMITONES=-5       # more negative = deeper (-4 .. -7 sensible)
TTS_GROWL=0.08               # 0 .. 0.6 roughness
TTS_DRIVE=0.4                # 0 = clean; above ~1 the voice gets muddy
TTS_LOW_BOOST=0.3            # bass body
TTS_PRESENCE=0.7             # consonant clarity (>1.5 kHz); raise if muddy

# --- Behavior policy ---
ULTRON_ALLOW_MOVEMENT=0      # 1 = the LLM may request abstract movements (firmware has its own gate too)
ULTRON_HISTORY_TURNS=4
ULTRON_MAX_REPLY_CHARS=200

# --- Deployment ---
#ULTRON_DATA_DIR=/var/lib/cerebro   # models, voices, debug audio (default: cerebro/var)
#DJANGO_SECRET_KEY=change-me
#ULTRON_LOG_LEVEL=INFO
ULTRON_PRELOAD=1             # load Whisper/Piper at server start
