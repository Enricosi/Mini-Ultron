# CEREBRO configuration. Copy to cerebro/.env (or the repo-root .env) on the machine that
# runs the backend. Real environment variables (e.g. systemd Environment=) win over this file.
# .env is gitignored: never commit real keys.

# --- LLM: provider + model are the only things to change to switch brains (docs/providers.md) ---
LLM_PROVIDER=groq            # groq | meta | ollama | openai_compat | fake
LLM_MODEL=openai/gpt-oss-120b   # meta: muse-spark-1.3
# API keys: each provider reads its own variable. LLM_API_KEY overrides it for the main provider.
GROQ_API_KEY=
MODEL_API_KEY=               # Meta Model API (provider=meta)
#LLM_API_KEY=
#LLM_BASE_URL=               # empty = provider default (required for openai_compat)
# One explicit fallback, tried when the main LLM fails (timeout, 429, HTTP error, invalid reply,
# missing key). Provider defaults to LLM_PROVIDER. Empty model = no fallback. When the main
# provider is groq the model defaults to openai/gpt-oss-20b; for any other provider it is off
# unless set here.
#LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
#LLM_FALLBACK_BASE_URL=
#LLM_FALLBACK_API_KEY=
LLM_TIMEOUT_S=20
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=400
LLM_STRUCTURED=json_schema   # json_schema | json_object | none
LLM_REASONING_EFFORT=low     # sent only to models known to accept it (gpt-oss, qwen)

# --- STT (faster-whisper, local) ---
STT_BACKEND=faster_whisper   # faster_whisper | fake
STT_MODEL=small              # tiny | base | small | medium | large-v3 ... (slower CPU => smaller)
STT_LANGUAGE=es              # empty = auto-detect
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=0            # 0 = library default (8 is best on the 16-thread server)
#STT_INITIAL_PROMPT=         # default biases Whisper toward the robot's command words; empty = off
STT_BEAM_SIZE=5              # measured negligible latency cost on the home-lab server; 1 = greedy/fastest

# --- TTS (Piper, local) ---
TTS_BACKEND=piper            # piper | fake
TTS_VOICE=es_ES-davefx-medium
TTS_LENGTH_SCALE=1.05        # >1 = slower, more solemn
TTS_PEAK=0.35                # reply loudness (fraction of full scale) at the ESP32 speaker
TTS_FX=deep                  # deep (clean, solemn, Thanos-like) | monster (gritty) | none
TTS_PITCH_SEMITONES=-3       # more negative = deeper (-4 already costs clarity)
TTS_GROWL=0                  # monster mode only
TTS_DRIVE=0                  # monster mode only
TTS_LOW_BOOST=0.3            # bass body
TTS_PRESENCE=0.5             # consonant clarity (>1.5 kHz); raise if muddy

# --- Behavior policy ---
ULTRON_ALLOW_MOVEMENT=0      # 1 = the LLM may request abstract movements (firmware has its own gate too)
ULTRON_HISTORY_TURNS=4
ULTRON_MAX_REPLY_CHARS=300
#ULTRON_MAX_BODY_BYTES=2097152   # largest utterance upload accepted
#ULTRON_MIN_AUDIO_S=0.3          # shorter audio is treated as a click
#ULTRON_PERSONALITY=ultron

# --- Deployment ---
#ULTRON_DATA_DIR=/var/lib/cerebro   # models, voices, debug audio (default: cerebro/var)
#DJANGO_SECRET_KEY=change-me
#ULTRON_LOG_LEVEL=INFO      # DEBUG | INFO | WARNING | ERROR
#DJANGO_ALLOWED_HOSTS=*     # comma-separated; * because the robot reaches CEREBRO by LAN IP
#ULTRON_SAVE_DEBUG_AUDIO=1  # keep the last utterance as var/debug/last_utterance.wav
ULTRON_PRELOAD=1             # load Whisper/Piper at server start
